{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Combined: Build",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/YS_F4Pro_Combined/build.ps1"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Combined: Flash",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/firmware/YS_F4Pro_Combined/build.ps1",
        "-Flash"
      ],
      "problemMatcher": "$gcc"
    }
  ]
}
